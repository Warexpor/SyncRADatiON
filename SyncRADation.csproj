<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SyncRADation</AssemblyName>
    <RootNamespace>SyncRADation</RootNamespace>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin/$(Configuration)/</OutputPath>
    <DebugType>portable</DebugType>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <!-- NetSchema.Hash mixes in the module's MVID (handshake rejects a stale/modified dll). With Deterministic the MVID is a
         content hash, but it also covers source paths (PDB, CallerFilePath): PathMap makes it independent of the checkout
         directory, so the same commit built in two places yields the same dll and the two players are not rejected. -->
    <PathMap>$(MSBuildProjectDirectory)=/src</PathMap>
    <!-- SourceLink would embed the checkout's absolute path and the commit hash in the PDB id (and so the MVID). -->
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Single-source version: Bootstrap/PluginInfo.cs `Version` is the only place to bump.
       Everything below (AssemblyVersion / FileVersion / InformationalVersion) is derived from it at build time.
       MelonInfo in Bootstrap/SyncRADationMod.cs already reads PluginInfo.Version directly. -->
  <PropertyGroup>
    <PluginInfoFile>$(MSBuildProjectDirectory)/Bootstrap/PluginInfo.cs</PluginInfoFile>
    <PluginVersion Condition="Exists('$(PluginInfoFile)')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText($(PluginInfoFile))), 'const\s+string\s+Version\s*=\s*"(\d+\.\d+\.\d+(?:\.\d+)?)"').Groups[1].Value)</PluginVersion>
    <Version>$(PluginVersion)</Version>
    <AssemblyVersion>$(PluginVersion).0</AssemblyVersion>
    <FileVersion>$(PluginVersion).0</FileVersion>
    <InformationalVersion>$(PluginVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>SyncRADation</AssemblyTitle>
    <Description>SIGNALIS Multiplayer Mod</Description>
    <Product>SyncRADation</Product>
    <Company></Company>
    <Copyright>Copyright (C) 2026 Warexpor</Copyright>
  </PropertyGroup>
  <Target Name="CheckPluginVersion" BeforeTargets="BeforeBuild;GenerateAssemblyInfo;CoreCompile">
    <Error Condition="'$(PluginVersion)' == ''" Text="Could not read 'const string Version' from Bootstrap/PluginInfo.cs" />
  </Target>

  <!-- SignalisDir = second-box copy (client). ClientSignalisDir = Steam (host). Override with -p: if needed. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <SignalisDir Condition="'$(SignalisDir)' == ''">C:\MyProjects\SIGNALIS</SignalisDir>
    <ClientSignalisDir Condition="'$(ClientSignalisDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\SIGNALIS</ClientSignalisDir>
  </PropertyGroup>
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <SignalisDir Condition="'$(SignalisDir)' == ''">$(HOME)/Work/MyProjects/SIGNALIS</SignalisDir>
    <ClientSignalisDir Condition="'$(ClientSignalisDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/SIGNALIS</ClientSignalisDir>
  </PropertyGroup>
  <PropertyGroup>
    <MelonLoaderDir>$(SignalisDir)/MelonLoader</MelonLoaderDir>
    <ManagedDir>$(MelonLoaderDir)/Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(MelonLoaderDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MelonLoader">
      <HintPath>$(MelonLoaderDir)\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(ManagedDir)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnhollowerBaseLib">
      <HintPath>$(ManagedDir)\UnhollowerBaseLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(ManagedDir)\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>$(ManagedDir)\UnityEngine.Physics2DModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ManagedDir)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(ManagedDir)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AstarPathfindingProject">
      <HintPath>$(ManagedDir)\AstarPathfindingProject.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(ManagedDir)\Sirenix.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FMODUnity">
      <HintPath>$(ManagedDir)\FMODUnity.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 1.3.5 net472 (NuGet 1.3.5 is netstandard2.0; MelonLoader 0.5.7 has no netstandard). Rebuild: third_party/LiteNetLib -->
    <Reference Include="LiteNetLib">
      <HintPath>lib/LiteNetLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="_tmp_ref\**" />
    <None Remove="_tmp_ref\**" />
    <Compile Remove="third_party\**" />
    <None Remove="third_party\**" />
    <!-- Test project lives in tests/ with its own csproj; never compile it (or its obj/bin) into the mod. -->
    <Compile Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <!-- Deploys into the game Mods folders after every build. scripts/build.sh sets the NoDeploy property unless deploy is requested. -->
  <Target Name="CopyToMods" AfterTargets="Build" Condition="'$(NoDeploy)' != 'true'">
    <MakeDir Directories="$(SignalisDir)/Mods" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SignalisDir)/Mods" />
    <Copy SourceFiles="$(TargetDir)LiteNetLib.dll" DestinationFolder="$(SignalisDir)/Mods" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)LiteNetLib.dll')" />
    <MakeDir Directories="$(ClientSignalisDir)/Mods" Condition="Exists('$(ClientSignalisDir)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ClientSignalisDir)/Mods" Condition="Exists('$(ClientSignalisDir)/Mods') Or Exists('$(ClientSignalisDir)')" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetDir)LiteNetLib.dll" DestinationFolder="$(ClientSignalisDir)/Mods" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)LiteNetLib.dll') And Exists('$(ClientSignalisDir)')" ContinueOnError="true" />
  </Target>
</Project>
